# ProFluencer Awards — frontend environment
#
# URL of the Laravel API (no trailing slash). All requests are made to
# <VITE_API_URL>/<path>, e.g. http://localhost:8000/api/v1/health
VITE_API_URL=http://localhost:8000/api/v1

# Demo mode — EXPLICIT OPT-IN ONLY.
#   VITE_DEMO_MODE=true   → static preview / local demo: falls back to the
#                           built-in DEMO data store (localStorage, clearly
#                           labelled sample data) when the API is unreachable.
#                           This powers the GitHub Pages preview.
#   unset / anything else → PRODUCTION: every data call goes to the Laravel
#                           API. API failures surface as errors in the UI —
#                           demo data can NEVER silently substitute for
#                           failed production API data.
#
# NEVER set VITE_DEMO_MODE=true in a production build.
# VITE_DEMO_MODE=true
