# ------------------------------------------------------------------
# ProFluencer Awards — API backend
# Copy to .env and fill in real values. Never commit .env.
# ------------------------------------------------------------------
APP_NAME="ProFluencer Awards"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.profluencerawards.com
APP_TIMEZONE=Asia/Dubai

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------- Database (MySQL — cPanel shared hosting) --------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=profluencer_awards
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Queue: database driver (no Horizon/Octane on shared hosting).
# Run via cron: php artisan queue:work --stop-when-empty
QUEUE_CONNECTION=database

CACHE_DRIVER=database

# ---------------- Mail (OTP + notifications) -----------------------
# cPanel: use the SMTP account created in "Email Accounts", or 'sendmail'.
MAIL_MAILER=smtp
MAIL_HOST=mail.profluencerawards.com
MAIL_PORT=465
MAIL_USERNAME=noreply@profluencerawards.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@profluencerawards.com"
MAIL_FROM_NAME="ProFluencer Awards"

# ---------------- Voting / OTP -------------------------------------
# 6-digit email OTP, 10-minute expiry, max 5 attempts per code.
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# First admin user, created by the seeder (password is hashed).
ADMIN_EMAIL=admin@profluencerawards.com
ADMIN_PASSWORD=
ADMIN_NAME="Awards Admin"

# Sanctum / CORS: frontend origins allowed to call the API.
SANCTUM_STATEFUL_DOMAINS=profluencerawards.com,www.profluencerawards.com
FRONTEND_URL=https://profluencerawards.com
