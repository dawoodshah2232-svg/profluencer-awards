# ------------------------------------------------------------------
# ProFluencer Awards — PRODUCTION .env template (cPanel)
#
# Rendered by .github/workflows/deploy.yml into the server's backend/.env
# on every deploy. NO SECRETS HERE: every {{NAME}} placeholder is filled
# from a GitHub Actions secret (or kept from the server, for APP_KEY).
# Edit non-secret values here and push to main to change production.
# ------------------------------------------------------------------
APP_NAME="ProFluencer Awards"
APP_ENV=production
APP_KEY={{APP_KEY}}
APP_DEBUG=false
APP_URL=https://profluencerawards.com
APP_TIMEZONE=Asia/Dubai

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------- Database (cPanel MySQL) --------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=profluencer_awards
DB_USERNAME=profluencer_awards
DB_PASSWORD={{DB_PASSWORD}}

SESSION_DRIVER=database
SESSION_LIFETIME=120

# OTP mails are queued; the cPanel cron runs `queue:work --stop-when-empty`.
QUEUE_CONNECTION=database
CACHE_DRIVER=database

# ---------------- Mail (OTP + notifications) -----------------------
# MAIL_MAILER is switched to "sendmail" automatically when the
# MAIL_PASSWORD secret is empty (cPanel's local mailer, no SMTP login).
MAIL_MAILER=smtp
MAIL_HOST=mail.profluencerawards.com
MAIL_PORT=465
MAIL_USERNAME=noreply@profluencerawards.com
MAIL_PASSWORD={{MAIL_PASSWORD}}
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@profluencerawards.com"
MAIL_FROM_NAME="ProFluencer Awards"

# ---------------- Voting / OTP -------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------------- Seeded logins --------------------------------------
# Created once by the seeders (firstOrCreate / skip-if-exists): changing
# these later never resets a password someone changed in the app.
ADMIN_EMAIL=admin@profluencerawards.com
ADMIN_PASSWORD={{ADMIN_PASSWORD}}
ADMIN_NAME="Awards Admin"
DEMO_USER_EMAIL=user@profluencerawards.com
DEMO_USER_PASSWORD={{DEMO_USER_PASSWORD}}

# Frontend and API share one domain (API under /api), so CORS only
# matters for www vs non-www.
SANCTUM_STATEFUL_DOMAINS=profluencerawards.com,www.profluencerawards.com
FRONTEND_URL=https://profluencerawards.com,https://www.profluencerawards.com
